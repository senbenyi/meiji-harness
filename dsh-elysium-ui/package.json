{
  "name": "@dsh-external/dsh-elysium-ui",
  "version": "0.1.0",
  "description": "极乐世界：媒体任务卡与导演设置",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "package:registry": "node scripts/package-registry.mjs"
  },
  "dependencies": {
    "schemastery": "3.18.0"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-test-renderer": "18.2.0"
  },
  "license": "MIT"
}
