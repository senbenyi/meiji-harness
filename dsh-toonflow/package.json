{
  "name": "@dsh-external/dsh-toonflow",
  "version": "0.1.0",
  "type": "module",
  "description": "AI 短剧导演插件 — 项目管理、角色、分镜、生成、导出的可视化操作台",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  }
}
