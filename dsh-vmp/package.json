{
  "name": "@dsh-external/dsh-vmp",
  "version": "0.1.0",
  "description": "DeepSeek Harness VMP AI short-video production console and chat tool",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "skills", "cordis.patch.yml", "dsh.plugin.json", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-conversation"], "platform": "web" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.3 <2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3 <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.3.1"
  },
  "scripts": { "test": "node --test tests/*.test.js" },
  "license": "MIT"
}
