{
  "1": {
    "inputs": {
      "video": "input.mp4",
      "force_rate": 25,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    },
    "class_type": "VHS_LoadVideo",
    "_meta": {"title": "加载视频"}
  },
  "2": {
    "inputs": {
      "mmaudio_model": "mmaudio_large_44k_v2_fp16.safetensors",
      "base_precision": "fp16"
    },
    "class_type": "MMAudioModelLoader",
    "_meta": {"title": "加载 MMAudio"}
  },
  "3": {
    "inputs": {
      "vae_model": "mmaudio_vae_44k_fp16.safetensors",
      "synchformer_model": "mmaudio_synchformer_fp16.safetensors",
      "clip_model": "apple_DFN5B-CLIP-ViT-H-14-384_fp16.safetensors",
      "mode": "44k",
      "precision": "fp16"
    },
    "class_type": "MMAudioFeatureUtilsLoader",
    "_meta": {"title": "加载 MMAudio 特征模型"}
  },
  "4": {
    "inputs": {
      "mmaudio_model": ["2", 0],
      "feature_utils": ["3", 0],
      "images": ["1", 0],
      "duration": 20,
      "steps": 25,
      "cfg": 4.5,
      "seed": 42,
      "prompt": "cinematic environmental sound, synchronized natural movement",
      "negative_prompt": "speech, dialogue, voice-over, music, distortion, clipping",
      "mask_away_clip": false,
      "force_offload": true
    },
    "class_type": "MMAudioSampler",
    "_meta": {"title": "生成同步音效"}
  },
  "5": {
    "inputs": {
      "images": ["1", 0],
      "audio": ["4", 0],
      "frame_rate": 25,
      "loop_count": 0,
      "filename_prefix": "audio-generate-mmaudio/result",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "保存带音效视频"}
  }
}
