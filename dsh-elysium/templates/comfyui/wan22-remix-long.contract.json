{
  "id": "wan22-remix-long",
  "_bundleVersion": 3,
  "title": "Wan2.2 Remix NSFW v3 SVI Continuous Block",
  "workflow": "wan22-remix-long.json",
  "prompt_style": "natural_zh",
  "prompt_hint": "Exactly six ordered motion prompts using one identity anchor image and SVI latent continuity.",
  "media": { "in": ["image", "text"], "out": ["video"] },
  "capabilities": {
    "mode": ["i2v", "long_video", "svi_continuity"],
    "can": ["image", "six_prompts", "negative", "size", "seed", "video"],
    "cannot": ["t2i", "i2i", "audio", "arbitrary_segment_count"],
    "style": []
  },
  "slots": {
    "image": { "key": "image", "type": "image", "required": true, "node": "10", "field": "image" },
    "prompt_1": { "key": "prompt_1", "type": "text", "required": true, "node": "21", "field": "text" },
    "prompt_2": { "key": "prompt_2", "type": "text", "required": true, "node": "563", "field": "text" },
    "prompt_3": { "key": "prompt_3", "type": "text", "required": true, "node": "566", "field": "text" },
    "prompt_4": { "key": "prompt_4", "type": "text", "required": true, "node": "572", "field": "text" },
    "prompt_5": { "key": "prompt_5", "type": "text", "required": true, "node": "581", "field": "text" },
    "prompt_6": { "key": "prompt_6", "type": "text", "required": true, "node": "584", "field": "text" },
    "negative": {
      "key": "negative", "type": "text", "required": false,
      "injects": [
        { "node": "1", "field": "text" }, { "node": "560", "field": "text" },
        { "node": "565", "field": "text" }, { "node": "571", "field": "text" },
        { "node": "578", "field": "text" }, { "node": "583", "field": "text" }
      ]
    },
    "width": { "key": "width", "type": "number", "required": false, "node": "159", "field": "value" },
    "height": { "key": "height", "type": "number", "required": false, "node": "160", "field": "value" },
    "frames": { "key": "frames", "type": "number", "required": false, "node": "259", "field": "value" },
    "fps": { "key": "fps", "type": "number", "required": false, "node": "444", "field": "frame_rate" },
    "seed": {
      "key": "seed", "type": "seed", "required": false,
      "injects": [
        { "node": "399", "field": "noise_seed" }, { "node": "398", "field": "noise_seed" },
        { "node": "436", "field": "noise_seed" }, { "node": "438", "field": "noise_seed" },
        { "node": "454", "field": "noise_seed" }, { "node": "457", "field": "noise_seed" },
        { "node": "490", "field": "noise_seed" }, { "node": "491", "field": "noise_seed" },
        { "node": "511", "field": "noise_seed" }, { "node": "512", "field": "noise_seed" },
        { "node": "615", "field": "noise_seed" }, { "node": "616", "field": "noise_seed" }
      ]
    }
  },
  "loras": [],
  "models": {
    "clip": { "key": "clip", "node": "2", "field": "clip_name" },
    "clip_type": { "key": "clip_type", "node": "2", "field": "type" },
    "vae": { "key": "vae", "node": "3", "field": "vae_name" }
  },
  "notes": "Pinned Wan2.2 Remix NSFW v3 high/low models with SVI2Pro latent continuity. One identity anchor drives six ordered segments."
}
