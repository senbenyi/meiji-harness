{
  "id": "qwen-image-t2i",
  "title": "Qwen Image Text-to-Image",
  "workflow": "qwen-image-t2i.json",
  "prompt_style": "natural_en",
  "prompt_hint": "Describe one coherent fictional adult shot, composition, lighting and camera. The output is a vertical production keyframe.",
  "media": { "in": ["text"], "out": ["image"] },
  "capabilities": {
    "mode": ["t2i"],
    "can": ["prompt", "negative", "size", "seed", "image"],
    "cannot": ["i2i", "video", "audio", "logo"],
    "style": []
  },
  "slots": {
    "prompt": { "key": "prompt", "type": "text", "required": true, "node": "5", "field": "text" },
    "negative": { "key": "negative", "type": "text", "required": false, "node": "6", "field": "text" },
    "width": { "key": "width", "type": "number", "required": false, "node": "7", "field": "width" },
    "height": { "key": "height", "type": "number", "required": false, "node": "7", "field": "height" },
    "steps": { "key": "steps", "type": "number", "required": false, "node": "8", "field": "steps" },
    "cfg": { "key": "cfg", "type": "number", "required": false, "node": "8", "field": "cfg" },
    "seed": { "key": "seed", "type": "seed", "required": false, "node": "8", "field": "seed" }
  },
  "loras": [],
  "models": {
    "clip": { "key": "clip", "node": "2", "field": "clip_name" },
    "clip_type": { "key": "clip_type", "node": "2", "field": "type" },
    "vae": { "key": "vae", "node": "1", "field": "vae_name" }
  },
  "notes": "Validated Qwen Image API workflow. Requires NunchakuQwenImageDiTLoader and the configured Qwen image assets on the remote ComfyUI server."
}
