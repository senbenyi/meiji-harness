{
  "id": "mmaudio",
  "_bundleVersion": 1,
  "title": "MMAudio 同步环境音与拟音",
  "workflow": "mmaudio.json",
  "prompt_style": "natural_en",
  "prompt_hint": "Describe concrete environmental and action sounds synchronized to the full video. Do not request dialogue, voice-over, or music.",
  "media": { "in": ["video", "text"], "out": ["video", "audio"] },
  "capabilities": {
    "mode": ["video_audio", "audio"],
    "can": ["video_input", "prompt", "negative", "duration", "steps", "seed", "audio"],
    "cannot": ["speech", "voice_over", "music", "tts"],
    "style": []
  },
  "slots": {
    "video": { "key": "video", "type": "video", "required": true, "node": "1", "field": "video" },
    "prompt": { "key": "prompt", "type": "text", "required": true, "node": "4", "field": "prompt" },
    "negative": { "key": "negative", "type": "text", "required": false, "node": "4", "field": "negative_prompt" },
    "duration": { "key": "duration", "type": "number", "required": false, "node": "4", "field": "duration" },
    "steps": { "key": "steps", "type": "number", "required": false, "node": "4", "field": "steps" },
    "seed": { "key": "seed", "type": "seed", "required": false, "node": "4", "field": "seed" }
  },
  "loras": [],
  "models": {},
  "notes": "Aligned with llm-ai-model audio-generate-mmaudio. Generates synchronized environmental sound and Foley only; speech, voice-over, and music require separate capabilities."
}
