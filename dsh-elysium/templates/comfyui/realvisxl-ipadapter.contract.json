{
  "id": "realvisxl-ipadapter",
  "_bundleVersion": 1,
  "title": "RealVisXL V5.0 IP-Adapter Keyframe",
  "workflow": "realvisxl-ipadapter.json",
  "prompt_style": "natural_en",
  "prompt_hint": "Describe the next coherent adult frame while preserving the identity in the reference image.",
  "media": {"in": ["image", "text"], "out": ["image"]},
  "capabilities": {
    "mode": ["i2i", "keyframe", "identity_reference"],
    "can": ["prompt", "negative", "reference", "size", "seed"],
    "cannot": ["video", "audio"],
    "style": ["photorealistic"]
  },
  "slots": {
    "prompt": {"key": "prompt", "type": "text", "required": true, "node": "2", "field": "text"},
    "negative": {"key": "negative", "type": "text", "required": false, "node": "3", "field": "text"},
    "reference": {"key": "reference", "type": "image", "required": true, "node": "8", "field": "image"},
    "width": {"key": "width", "type": "number", "required": false, "node": "4", "field": "width"},
    "height": {"key": "height", "type": "number", "required": false, "node": "4", "field": "height"},
    "steps": {"key": "steps", "type": "number", "required": false, "node": "5", "field": "steps"},
    "cfg": {"key": "cfg", "type": "number", "required": false, "node": "5", "field": "cfg"},
    "seed": {"key": "seed", "type": "seed", "required": false, "node": "5", "field": "seed"}
  },
  "loras": [],
  "models": {
    "checkpoint": {"key": "checkpoint", "node": "1", "field": "ckpt_name"}
  },
  "notes": "Production identity-consistent keyframe workflow using RealVisXL V5.0 and IP-Adapter Plus Face SDXL."
}
