{
  "workflow_provider": "runpod",
  "legacy": {
    "comfyui": {
      "server_id": "minimax-h3",
      "service": "comfyui",
      "url_env": "COMFYUI_URL"
    },
    "llm": {
      "server_id": "legacy-qwen",
      "service": "llm",
      "base_url": "http://127.0.0.1:18000/v1",
      "connection": {
        "model": "qwen3.8-27b-elysium",
        "api_key_env": "QWEN38_LOCAL_API_KEY"
      }
    }
  },
  "legacy_tunnel": {
    "alias": "qwen",
    "service": "llm",
    "connection": {
      "transport": "ssh",
      "ssh_alias": "veo-qwen38",
      "remote_host": "127.0.0.1",
      "remote_port": 8000,
      "local_port": 18000,
      "api_path": "/v1"
    }
  },
  "llm_route": "qwen38-local",
  "services": {
    "comfyui": {
      "workload": "minimax-h3"
    },
    "llm": {
      "model": "qwen3.8-27b-elysium"
    }
  },
  "check_plans": [
    {
      "profile": "preview",
      "mode": "t2va"
    },
    {
      "profile": "regular",
      "mode": "t2va"
    },
    {
      "mode": "t2va"
    },
    {
      "mode": "i2va"
    },
    {
      "mode": "fl2va"
    },
    {
      "mode": "fl2va-loop"
    },
    {
      "mode": "r2va"
    }
  ]
}
