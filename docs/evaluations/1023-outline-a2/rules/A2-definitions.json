                "enum": [
                  "opening",
                  "continuous",
                  "cut"
                ]
              },
              "story_segment_id": {
                "type": "string",
                "description": "对应故事段ID。",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "description": "当前对象标题。",
                "minLength": 1
              },
              "key_anchor_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "segment_001_anchor_001；引用故事段中实际保存的锚点ID，已有ID保持原样。"
                }
              },
              "scene": {
                "type": "object",
                "properties": {
                  "scene_id": {
                    "type": "string",
                    "description": "明确关联的场景ID；无资产时为空。"
                  },
                  "state": {
                    "type": "string",
                    "description": "本镜开场环境状态及光照。"
                  },
                  "spatial_setup": {
                    "type": "string",
                    "description": "本镜背景区域的固定空间关系。"
                  }
                },
                "required": [
                  "scene_id",
                  "state",
                  "spatial_setup"
                ],
                "additionalProperties": false
              },
              "characters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "character_id": {
                      "type": "string",
                      "description": "关联人物ID；无资产时为空。"
                    },
                    "costume_id": {
                      "type": "string",
                      "description": "选定服装ID；无服装目录时为空。"
                    },
                    "name": {
                      "type": "string",
                      "description": "对象名称。",
                      "minLength": 1
                    },
                    "presence": {
                      "type": "string",
                      "description": "开场在场与入画状态。"
                    },
                    "position": {
                      "type": "string",
                      "description": "开场空间位置。"
                    },
                    "facing": {
                      "type": "string",
                      "description": "开场身体朝向。"
                    },
                    "gaze_target": {
                      "type": "string",
                      "description": "开场目光对象。"
                    }
                  },
                  "required": [
                    "character_id",
                    "costume_id",
                    "name",
                    "presence",
                    "position",
                    "facing",
                    "gaze_target"
                  ],
                  "additionalProperties": false
                }
              },
              "beats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "duration_seconds": {
                      "type": "number",
                      "description": "本段或节拍的正常表演预估时长，单位秒。",
                      "exclusiveMinimum": 0
                    },
                    "action": {
                      "type": "string",
                      "description": "本节拍行动与反应过程。"
                    },
                    "camera": {
                      "type": "string",
                      "description": "本节拍构图与摄影变化。"
                    },
                    "scene_changes": {
                      "type": "string",
                      "description": "本节拍独立追踪的环境变化。"
                    },
                    "effects": {
                      "type": "string",
                      "description": "本节拍特效表现。"
                    },
                    "audio": {
                      "type": "string",
                      "description": "本节拍原话与声音过程。"
                    }
                  },
                  "required": [
                    "duration_seconds",
                    "action",
                    "camera",
                    "scene_changes",
                    "effects",
                    "audio"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "previous_shot_connection",
              "story_segment_id",
              "title",
              "key_anchor_ids",
              "scene",
              "characters",
              "beats"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "shots"
      ],
      "additionalProperties": false
    }
