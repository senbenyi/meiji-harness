  "shot_design": {
    "kind": "text",
    "output": {
      "type": "object",
      "properties": {
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "稳定标识；已有对象保留原ID。",
                "minLength": 1
              },
              "previous_shot_connection": {
                "type": "string",
