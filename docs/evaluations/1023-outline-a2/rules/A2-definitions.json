{
  "$defs": {
    "review_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "passed",
              "description": "通过。"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "候选或实际引用上游的具体对象和字段位置。",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "description": "当前仍成立的问题事实及依据。",
                    "minLength": 1
                  },
                  "suggestion": {
                    "type": "string",
                    "description": "最小修正方向；需改上游或规则时明确处理位置。",
                    "minLength": 1
                  }
                },
                "required": [
                  "location",
                  "reason",
                  "suggestion"
                ],
                "additionalProperties": false
              },
              "maxItems": 0
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "本节点内容问题、上游问题或规则冲突。",
              "enum": [
                "content_issue",
                "upstream_issue",
                "rule_conflict"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "候选或实际引用上游的具体对象和字段位置。",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "description": "当前仍成立的问题事实及依据。",
                    "minLength": 1
                  },
                  "suggestion": {
                    "type": "string",
                    "description": "最小修正方向；需改上游或规则时明确处理位置。",
                    "minLength": 1
                  }
                },
                "required": [
                  "location",
                  "reason",
                  "suggestion"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        }
      ]
    },
    "image_output": {
      "type": "image",
      "description": "返回图片接口的真实媒体结果，由适配器解析并保存有效图片地址；不让语言模型编造JSON地址。"
    }
  },
  "basic_info": {
    "kind": "text",
    "output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "当前项目剧本的剧情摘要，概括主要人物、冲突、发展与结局，不添加原稿未提供的信息。",
          "minLength": 1
        },
        "estimated_duration_seconds": {
          "type": "number",
          "description": "完整剧本按正常表演节奏呈现的预估总时长，单位秒；综合对白、动作、停顿与转场估计，不照抄参考单集时长。",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "summary",
        "estimated_duration_seconds"
      ],
      "additionalProperties": false
    }
  },
  "script_revision": {
    "kind": "text",
    "output": {
      "type": "object",
      "properties": {
        "actual_script": {
          "type": "string",
          "description": "当前完整工作剧本正文。",
          "minLength": 1
        },
        "estimated_duration_seconds": {
          "type": "number",
          "description": "完整优化剧本的预估总时长，单位秒。",
          "exclusiveMinimum": 0
        },
        "summary": {
          "type": "string",
          "description": "当前内容概要。"
        }
      },
      "required": [
        "actual_script",
        "estimated_duration_seconds",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "story_segments": {
    "kind": "text",
    "output_format": "template",
    "output": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "segment_001",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "description": "故事段标题。",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "description": "最终改编定稿的完整剧情正文、对白及重要描述；按因果与阶段结果分段，不是事件摘要，供下游视听实现。",
                "minLength": 1
              },
              "world_background": {
                "type": "string",
                "description": "与本段有关的世界观、时代背景和影响剧情的重要设定；不另设全剧共用资料对象。"
              },
              "key_anchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "segment_001_anchor_001；新建锚点使用所属故事段ID加_anchor_及至少三位正整数序号，段内从001递增，整份大纲唯一；已有锚点保留原ID。",
                      "minLength": 1
                    },
                    "content": {
                      "type": "string",
                      "description": "本段必须表达的事实、态度、程度、情绪、世界观信息或伏笔。"
                    },
                    "expression": {
                      "type": "string",
                      "description": "以画面、对白、动作、声音或其组合落实的要求；明确原话与画面文字仍逐字保留。"
                    }
                  },
                  "required": [
                    "id",
                    "content",
                    "expression"
                  ],
                  "additionalProperties": false
                }
              },
              "characters_and_groups": {
                "type": "string",
                "description": "参与人物、背景群体、在场状态及各自作用；不重复保存完整人物资产。"
              },
              "scene_and_space": {
                "type": "string",
                "description": "所在场景、初始分布、建筑区域及行动关系；稳定布局由场景资产提供。"
              },
              "emotion_and_rhythm": {
                "type": "string",
                "description": "情绪起止、压力积累、转折、释放及观看期待。"
              },
              "duration_seconds": {
                "type": "number",
                "description": "最终剧情正常表演的粗略预估时长，单位秒，大于0；仅供制作参考，不作为剧情或分段的时间限制。",
                "exclusiveMinimum": 0
              },
              "continuity": {
                "type": "object",
                "properties": {
                  "opening": {
                    "type": "string",
                    "description": "承接前段的事实和初始状态。"
                  },
                  "ending": {
                    "type": "string",
                    "description": "本段结果、待续事项及后段承接。"
                  }
                },
                "required": [
                  "opening",
                  "ending"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "title",
              "body",
              "world_background",
              "key_anchors",
              "characters_and_groups",
              "scene_and_space",
              "emotion_and_rhythm",
              "duration_seconds",
              "continuity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "segments"
      ],
      "additionalProperties": false
    }
  },
