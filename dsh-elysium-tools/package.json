{
  "name": "@dsh-external/dsh-elysium-tools",
  "version": "0.4.0",
  "description": "极乐世界 AI 成人短剧媒体工具，配合 DeepSeek Harness 标准模式完成图片与视频素材生成及任务续做。",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20.16"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    ".dsh"
  ],
  "scripts": {
    "build": "node build-scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "package:registry": "node build-scripts/package-registry.mjs"
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-test-renderer": "18.2.0"
  }
}
