{
  "name": "@dsh-external/dsh-elysium-tools",
  "version": "0.4.0",
  "description": "AI短剧创作插件。",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20.16"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "workflow:sync": "node scripts/sync_runpod_video_workflows.mjs --sync",
    "workflow:check": "node scripts/sync_runpod_video_workflows.mjs --check",
    "package:registry": "node scripts/package-registry.mjs"
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-test-renderer": "18.2.0"
  }
}
