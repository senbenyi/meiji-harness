{
  "id": "elysium-qwen-image-21-i2i",
  "version": 1,
  "capability": "image.image2image",
  "runner": "comfyui",
  "displayName": "Qwen-Image 2.1 图生图（参考图改绘） · Elysium",
  "description": "Elysium Qwen-Image 2.1 参考图改绘工作流。",
  "note": "需要 ComfyUI ≥ v0.37.0；输出尺寸跟随首张参考图，最多支持 10 张参考图；cfg 固定为 1。",
  "group": "elysium-qwen-image-21-i2i",
  "requiresNodes": [
    "TextEncodeQwenImage21",
    "QwenImage21Cache"
  ],
  "output": {
    "mediaType": "image",
    "hasAudio": false
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "qwen-image-2.1-UC-int8_convrot.safetensors",
      "env": "DSH_SVS_QWEN21_UNET",
      "label": "Qwen-Image 2.1 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_8b_int8_convrot.safetensors",
      "env": "DSH_SVS_QWEN21_CLIP",
      "label": "Qwen3-VL 8B 文本编码器"
    },
    "vae": {
      "kind": "vae",
      "default": "qwen_image_2.1_vae_bf16.safetensors",
      "env": "DSH_SVS_QWEN21_VAE",
      "label": "Qwen-Image 2.1 VAE"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "4": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "device": "auto",
        "dtype": "int8"
      }
    },
    "5": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "prompt": null,
        "negative_prompt": "",
        "resolution": 1056
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": null,
        "steps": null,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": [
          "4",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "5",
          1
        ],
        "latent_image": [
          "5",
          2
        ]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "7",
          0
        ],
        "filename_prefix": null
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "steps"
      }
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "8",
        "field": "filename_prefix"
      }
    },
    "refs": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "images.image_${i+1}"
      },
      "max": 10
    },
    "reference_pixels": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "resolution"
      }
    }
  },
  "tiers": {
    "fast": {
      "displayName": "Qwen-Image 2.1 图生图（参考图改绘）（调试 768 预算） · Elysium",
      "estSeconds": 4,
      "mode": {
        "steps": 20,
        "referencePixels": 589824
      },
      "paramDefaults": {
        "reference_pixels": 768
      },
      "resolution": {
        "default": [
          768,
          768
        ]
      }
    },
    "balanced": {
      "displayName": "Qwen-Image 2.1 图生图（参考图改绘）（日常 1056 预算） · Elysium",
      "estSeconds": 8,
      "mode": {
        "steps": 30,
        "referencePixels": 1115136
      },
      "paramDefaults": {
        "reference_pixels": 1056
      },
      "resolution": {
        "default": [
          1056,
          1056
        ]
      }
    },
    "quality": {
      "displayName": "Qwen-Image 2.1 图生图（参考图改绘）（成片 2K 预算） · Elysium",
      "estSeconds": 60,
      "mode": {
        "steps": 40,
        "referencePixels": 4194304
      },
      "paramDefaults": {
        "reference_pixels": 2048
      },
      "resolution": {
        "default": [
          2048,
          2048
        ]
      }
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32
  },
  "constraints": {
    "aspectRatios": []
  },
  "priority": -100
}
