{
  "id": "minimax-h3-i2v-elysium-balanced",
  "version": 1,
  "capability": "video.image2video",
  "lengthGrid": [
    17,
    5
  ],
  "runner": "comfyui",
  "displayName": "MiniMax H3 首末帧生成视频 · Elysium DaSiWa balanced",
  "description": "Elysium 本机 DaSiWa MiniMax H3 Hybrid 4-step i2v 工作流。",
  "output": {
    "mediaType": "video",
    "hasAudio": true
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "DasiwaMinimaxH3_dasiwaHybrid4turboV1.safetensors",
      "label": "DaSiWa MiniMax H3 Hybrid 4-step"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors",
      "label": "本机 MiniMax H3 CLIP"
    },
    "vae": {
      "kind": "vae",
      "default": "minimax_h3_video_vae_fp16.safetensors",
      "label": "H3 视频 VAE"
    },
    "audio_vae": {
      "kind": "vae",
      "default": "minimax_h3_audio_vae_fp32.safetensors",
      "label": "H3 音频 VAE"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": {
        "model": [
          "$model",
          0
        ],
        "shift_video": 9,
        "shift_audio": 4
      }
    },
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "minimax"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "5": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "prompt": null,
        "width": null,
        "height": null,
        "length": null
      }
    },
    "6": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": null
      }
    },
    "7": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "scheduler": "simple",
        "steps": null,
        "denoise": 1
      }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "6",
          0
        ],
        "guider": [
          "7",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "5",
          1
        ]
      }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "11",
          0
        ],
        "audio": [
          "11a",
          0
        ],
        "fps": null
      }
    },
    "13": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "12",
          0
        ],
        "filename_prefix": null,
        "format": "mp4",
        "codec": "h264"
      }
    },
    "4a": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.audio_vae"
      }
    },
    "11a": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "10",
          0
        ],
        "vae": [
          "4a",
          0
        ]
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "length": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "length"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "noise_seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "9",
        "field": "steps"
      }
    },
    "fps": {
      "inject": "scalar",
      "to": {
        "node": "12",
        "field": "fps"
      },
      "default": 24
    },
    "first_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "first_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "last_frame": {
      "inject": "image",
      "via": "node",
      "node": "LoadImage",
      "to": {
        "node": "5",
        "field": "last_frame"
      },
      "preprocess": [
        {
          "class_type": "ImageScale",
          "inputs": {
            "upscale_method": "lanczos",
            "width": "${width}",
            "height": "${height}",
            "crop": "disabled"
          }
        }
      ]
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "13",
        "field": "filename_prefix"
      }
    }
  },
  "modes": {
    "balanced": {
      "steps": 4,
      "longSide": 1344,
      "loras": []
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32,
    "default": {
      "balanced": [
        1344,
        768
      ]
    }
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1"
    ],
    "maxDurationFrames": 310,
    "supportsSubtitles": true
  },
  "group": "minimax-h3-i2v-elysium",
  "tier": "balanced",
  "note": "Elysium 用户工作流：以当前 ComfyUI 的 DaSiWa Hybrid 4-step、H3 CLIP 与 VAE 文件为准；不叠加作者模板的外置 LoRA。",
  "priority": -100
}
