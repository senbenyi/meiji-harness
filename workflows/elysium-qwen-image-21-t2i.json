{
  "id": "elysium-qwen-image-21-t2i",
  "version": 1,
  "capability": "image.text2image",
  "runner": "comfyui",
  "displayName": "Qwen-Image 2.1 文生图 · Elysium",
  "description": "Elysium Qwen-Image 2.1 文生图工作流。",
  "note": "需要 ComfyUI ≥ v0.37.0；支持 2K 与 RGBA 透明背景；cfg 固定为 1。透明图需在提示词中声明透明背景并输出 PNG。",
  "group": "elysium-qwen-image-21-t2i",
  "requiresNodes": [
    "TextEncodeQwenImage21"
  ],
  "output": {
    "mediaType": "image",
    "hasAudio": false
  },
  "modelNode": "1",
  "assets": {
    "unet": {
      "kind": "checkpoint",
      "default": "qwen-image-2.1-UC-int8_convrot.safetensors",
      "env": "DSH_SVS_QWEN21_UNET",
      "label": "Qwen-Image 2.1 UNet"
    },
    "clip": {
      "kind": "clip",
      "default": "qwen3vl_8b_int8_convrot.safetensors",
      "env": "DSH_SVS_QWEN21_CLIP",
      "label": "Qwen3-VL 8B 文本编码器"
    },
    "vae": {
      "kind": "vae",
      "default": "qwen_image_2.1_vae_bf16.safetensors",
      "env": "DSH_SVS_QWEN21_VAE",
      "label": "Qwen-Image 2.1 VAE"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$assets.unet",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$assets.clip",
        "type": "qwen_image",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$assets.vae"
      }
    },
    "4": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "prompt": null,
        "negative_prompt": "",
        "resolution": 1024
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": null,
        "height": null,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "seed": null,
        "steps": null,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": [
          "$model",
          0
        ],
        "positive": [
          "4",
          0
        ],
        "negative": [
          "4",
          1
        ],
        "latent_image": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "7",
          0
        ],
        "filename_prefix": null
      }
    }
  },
  "params": {
    "prompt": {
      "inject": "scalar",
      "to": {
        "node": "4",
        "field": "prompt"
      }
    },
    "width": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "width"
      }
    },
    "height": {
      "inject": "scalar",
      "to": {
        "node": "5",
        "field": "height"
      }
    },
    "seed": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "seed"
      }
    },
    "steps": {
      "inject": "scalar",
      "to": {
        "node": "6",
        "field": "steps"
      }
    },
    "prefix": {
      "inject": "scalar",
      "to": {
        "node": "8",
        "field": "filename_prefix"
      }
    }
  },
  "tiers": {
    "fast": {
      "displayName": "Qwen-Image 2.1 文生图（调试 1MP） · Elysium",
      "estSeconds": 3,
      "mode": {
        "steps": 20,
        "longSide": 1024
      },
      "resolution": {
        "longSide": 1024,
        "default": [
          1024,
          576
        ]
      }
    },
    "balanced": {
      "displayName": "Qwen-Image 2.1 文生图（日常 1344） · Elysium",
      "estSeconds": 5,
      "mode": {
        "steps": 30,
        "longSide": 1344
      },
      "resolution": {
        "longSide": 1344,
        "default": [
          1344,
          768
        ]
      }
    },
    "quality": {
      "displayName": "Qwen-Image 2.1 文生图（成片 2K） · Elysium",
      "estSeconds": 45,
      "mode": {
        "steps": 40,
        "longSide": 2048
      },
      "resolution": {
        "longSide": 2048,
        "default": [
          2048,
          1152
        ]
      }
    }
  },
  "resolution": {
    "policy": "aspect-ratio",
    "snap": 32
  },
  "constraints": {
    "aspectRatios": [
      "16:9",
      "9:16",
      "1:1",
      "4:3",
      "3:2"
    ]
  },
  "priority": -100
}
