{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh.local/schemas/production-pipeline.schema.json",
  "title": "Production Pipeline",
  "description": "声明式 AI 短剧生产 DAG。Pipeline 只描述执行契约；Project Domain 保存权威业务状态。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "phases", "nodes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/phase" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/name" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "phase", "dependsOn", "commit"],
      "properties": {
        "id": { "$ref": "#/definitions/name" },
        "kind": { "type": "string", "enum": ["agent", "barrier"] },
        "role": { "$ref": "#/definitions/name" },
        "phase": { "$ref": "#/definitions/name" },
        "foreach": { "$ref": "#/definitions/name" },
        "concurrency": { "type": "integer", "minimum": 1 },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "outputSchema": {
          "type": "string",
          "pattern": "^production/[a-z0-9._/-]+\\.schema\\.json(#/definitions/[a-z0-9._-]+)?$"
        },
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handler"],
          "properties": {
            "handler": { "$ref": "#/definitions/name" },
            "kind": { "$ref": "#/definitions/name" }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "timeoutMs", "retryOn"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "retryOn": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["timeout", "invalid-output", "retryable-error"] }
            }
          }
        },
        "invalidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objective", "constraints"],
          "properties": {
            "objective": { "type": "string", "minLength": 1 },
            "constraints": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "agent" } } },
          "then": { "required": ["role", "inputs", "outputSchema", "validators", "retry", "prompt"] }
        },
        {
          "if": { "properties": { "kind": { "const": "barrier" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["role"] },
                { "required": ["foreach"] },
                { "required": ["concurrency"] },
                { "required": ["inputs"] },
                { "required": ["outputSchema"] },
                { "required": ["validators"] },
                { "required": ["retry"] },
                { "required": ["prompt"] }
              ]
            }
          }
        }
      ]
    }
  }
}
