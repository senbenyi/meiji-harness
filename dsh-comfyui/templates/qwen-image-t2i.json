{
  "1": {
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {"title": "Qwen Image VAE"}
  },
  "2": {
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen Image Text Encoder"}
  },
  "3": {
    "inputs": {
      "model_name": "svdq-int4_r32-qwen-image.safetensors",
      "cpu_offload": "enable",
      "num_blocks_on_gpu": 20,
      "use_pin_memory": "disable"
    },
    "class_type": "NunchakuQwenImageDiTLoader",
    "_meta": {"title": "Qwen Image T2I"}
  },
  "4": {
    "inputs": {
      "shift": 3.1,
      "model": ["3", 0]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Qwen Image Sampling"}
  },
  "5": {
    "inputs": {
      "text": "Vertical cinematic portrait of fictional adults.",
      "clip": ["2", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"}
  },
  "6": {
    "inputs": {
      "text": " ",
      "clip": ["2", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"}
  },
  "7": {
    "inputs": {
      "width": 720,
      "height": 1280,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Empty T2I Latent"}
  },
  "8": {
    "inputs": {
      "seed": 666,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "T2I Sampler"}
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode Image"}
  },
  "10": {
    "inputs": {
      "filename_prefix": "mvp/t2i/result",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save T2I Image"}
  }
}

