{
  "name": "dsh-short-video-studio",
  "version": "1.8.2",
  "description": "基于 deepseek harness 的短剧/动画画布工作室：仅分发按本机 GPU 配置并验证的 Elysium Qwen Image 2.1 与 MiniMax H3 工作流，以及对应 Elysium skills。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "comfyui",
    "minimax-h3",
    "dsh-plugin",
    "qwen-image",
    "short-video",
    "animation",
    "canvas",
    "skill"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "studio",
    "skills",
    "scripts",
    "workflows",
    "schemas",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengyungithub/dsh-short-video-studio.git"
  },
  "homepage": "https://github.com/fengyungithub/dsh-short-video-studio#readme",
  "bugs": {
    "url": "https://github.com/fengyungithub/dsh-short-video-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:domain": "node --test tests/domain/*.test.js tests/storage/*.test.js tests/media/*.test.js tests/integration/*.test.js",
    "smoke": "node scripts/smoke-tools.mjs && node scripts/smoke-manifest.mjs && node scripts/smoke-render.mjs && node scripts/smoke-tier-resolution.mjs && node scripts/smoke-video-shape.mjs && node scripts/smoke-skill-install.mjs && node scripts/smoke-client-settings.mjs && node scripts/smoke-canvas-home.mjs && node scripts/smoke-canvas-theme.mjs && node scripts/preview-toolbar.mjs --assert && node scripts/preview-canvas.mjs --assert && node scripts/smoke-assets.mjs && node scripts/smoke-upload-assets.mjs && node scripts/smoke-preask-deliver.mjs && node scripts/smoke-pdf.mjs",
    "prepublishOnly": "npm run smoke",
    "e2e:tier": "node scripts/e2e-tier-pipeline.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.9.0"
  }
}
